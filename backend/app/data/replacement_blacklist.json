{
  "schema_version": 1,
  "description": "AFTER 侧替换黑名单与分语境替换池。用于阻止修掉旧 AI 信号时引入新的生硬表达。",
  "hard_banned": [
    "不只仅",
    "另先看",
    "再往下",
    "协作体系环境",
    "合作协作体系",
    "完整流程的响应机制",
    "数据的提升作用",
    "提升者",
    "激励与惩戒完整流程",
    "先看",
    "到这里",
    "反智降重",
    "首先来看",
    "然后我们来看",
    "最后我们来看",
    "完整流程"
  ],
  "discouraged": [
    {
      "product": "不只",
      "reason": "替代“不仅”时口语化，正式论文降格",
      "only_when": "原文整体是口语或访谈体"
    },
    {
      "product": "协作体系",
      "reason": "替代“生态”时语义变平，丢掉主体关系和资源网络",
      "only_when": "上下文确实讨论协作组织结构"
    },
    {
      "product": "完整流程",
      "reason": "作为“闭环”的默认替换在标题或抽象语境中生硬",
      "only_when": "明确讨论流程步骤且“全流程”仍不够准确"
    }
  ],
  "context_pools": {
    "闭环": {
      "control": [
        "反馈回路",
        "反馈机制"
      ],
      "management": [
        "全流程",
        "各环节衔接"
      ],
      "forbidden": [
        "完整流程"
      ]
    },
    "生态": {
      "default": [
        "协作关系",
        "资源网络"
      ],
      "forbidden": [
        "生态体系"
      ]
    },
    "赋能": {
      "default": [
        "提升…的能力",
        "为…提供支持",
        "让…能够"
      ],
      "forbidden": []
    },
    "抓手": {
      "default": [
        "切入点",
        "方法",
        "手段"
      ],
      "forbidden": []
    },
    "痛点": {
      "default": [
        "问题",
        "困难",
        "瓶颈"
      ],
      "forbidden": []
    }
  }
}
